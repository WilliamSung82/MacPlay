{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "../../build/engine",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "ignoreDeprecations": "6.0",
    "allowJs": true
  },
  "include": [
    "*.ts",
    "protocol/*.ts",
    "*.cjs"
  ],
  "exclude": [
    "**/*.test.cjs",
    "test-support/**"
  ]
}
